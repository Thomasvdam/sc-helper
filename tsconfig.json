{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"moduleResolution": "Bundler",
		"module": "ES2022",
		"esModuleInterop": true,
		"sourceMap": false,
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["ES2023", "ESNext.Disposable", "DOM"],
		"noEmitOnError": true,
		"types": ["chrome", "dom-navigation"]
	},
	"include": ["src/*", "src/options-ui/app.ts"]
}
