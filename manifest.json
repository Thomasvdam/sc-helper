{
	"manifest_version": 3,
	"name": "SoundCloud Helper",
	"description": "Collection of tools to make my SoundCloud experience better",
	"version": "1.1.1",
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	},
	"content_scripts": [
		{
			"js": ["main.js"],
			"matches": ["https://soundcloud.com/*"],
			"run_at": "document_start"
		},
		{
			"js": ["interceptors.js"],
			"matches": ["https://soundcloud.com/*"],
			"run_at": "document_start",
			"world": "MAIN"
		}
	],
	"host_permissions": ["*://*.soundcloud.com/"],
	"permissions": ["storage", "cookies"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_ui": {
		"page": "options-ui/index.html",
		"open_in_tab": false
	}
}
